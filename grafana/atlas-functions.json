        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "function",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E",
                "Value #F",
                "Value #G"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "function": 0
            },
            "renameByName": {
              "Value #A": "Calls",
              "Value #B": "Total time",
              "Value #C": "Average",
              "Value #D": "p95",
              "Value #E": "Errors",
              "Value #F": "Bytes",
              "Value #G": "Running now",
