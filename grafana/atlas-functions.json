{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus or VictoriaMetrics",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
