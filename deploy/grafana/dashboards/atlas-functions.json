{
 "uid": "atlas-functions",
 "title": "Atlas: Functions",
 "description": "Every timed operation: what takes longest, what runs most, what moves the most bytes, what fails.",
 "tags": [
  "atlas"
 ],
 "schemaVersion": 39,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timezone": "browser",
 "links": [
  {
   "title": "Atlas",
   "type": "dashboards",
   "tags": [
    "atlas"
   ],
   "asDropdown": false,
   "includeVars": false,
   "keepTime": true,
   "icon": "external link",
   "targetBlank": false
  }
 ],
 "templating": {
  "list": [
   {
    "name": "function",
    "label": "Function",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "victoriametrics"
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(atlas_function_duration_seconds_count, function)",
     "refId": "A"
    },
    "definition": "label_values(atlas_function_duration_seconds_count, function)",
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 2,
   "type": "row",
   "title": "What takes the longest",
   "collapsed": false,
   "panels": [],
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "id": 3,
   "type": "bargauge",
   "title": "Most time in range",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "h": 14,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "expr": "topk(25, sum by (function) (increase(atlas_function_duration_seconds_sum{function=~\"$function\"}[$__range])))",
     "legendFormat": "{{function}}",
     "editorMode": "code",
     "instant": true,
     "range": false,
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "color": {
      "mode": "continuous-BlYlRd"
     },
     "unit": "s",
     "links": [
      {
       "title": "Just this function",
       "url": "/d/atlas-functions?var-function=${__field.labels.function}&${__url_time_range}",
       "targetBlank": false
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "valueMode": "text",
    "reduceOptions": {
