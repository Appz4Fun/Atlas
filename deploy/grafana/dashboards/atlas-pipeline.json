    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "Articles",
      "desc": true
     }
    ]
   },
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "group",
      "mode": "outer"
     }
    },
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "names": [
        "group",
        "Value #A",
        "Value #B",
        "Value #C"
       ]
      }
     }
    },
    {
     "id": "organize",
     "options": {
      "renameByName": {
       "group": "Group",
       "Value #A": "Articles",
       "Value #B": "Post bytes",
       "Value #C": "Last indexed"
      },
      "indexByName": {
       "group": 0,
       "Value #A": 1,
       "Value #B": 2,
       "Value #C": 3
      }
     }
    }
   ]
